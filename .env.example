# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables. Never prefix any of them with NEXT_PUBLIC_.

# Kill switch. "true" disables every paid call (hosted key and visitor keys);
# only recorded examples remain. Any value other than false/0/no/off counts as on.
DEMO_ONLY=false

# Server-side OpenAI key for hosted live runs. Leave empty for a demo-only deployment.
OPENAI_API_KEY=

# Upstash Redis REST credentials for the shared daily quota. Required for hosted
# live runs on Vercel; without them, local development uses an in-memory counter.
# The Vercel Marketplace integration's KV_REST_API_URL / KV_REST_API_TOKEN also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Daily limits for hosted live runs, reset at 00:00 UTC. Analysis and specification
# requests are counted separately, so one full run uses one of each. 0 disables hosted runs.
LIVE_RUNS_PER_IP_PER_DAY=3
LIVE_RUNS_GLOBAL_PER_DAY=30
